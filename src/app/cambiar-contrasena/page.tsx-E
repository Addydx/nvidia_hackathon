"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import AuthForm, { postJson } from "@/components/AuthForm";

type Estado = "cargando" | "listo" | "invalido";

/** Destino del enlace del correo: los tokens llegan en el #hash, se canjean por cookies httpOnly y se borran de la URL. */
export default function CambiarContrasena() {
  const [estado, setEstado] = useState<Estado>("cargando");

  useEffect(() => {
    let vivo = true;
    (async () => {
      const hash = new URLSearchParams(window.location.hash.replace(/^#/, ""));
      const access = hash.get("access_token");
      const refresh = hash.get("refresh_token");
      if (window.location.hash) history.replaceState(null, "", window.location.pathname); // los tokens no se quedan en la URL
      if (access && refresh) {
        const r = await postJson("/api/auth/sesion", { access_token: access, refresh_token: refresh, expires_in: Number(hash.get("expires_in")) || undefined });
        if (vivo) setEstado(r.ok ? "listo" : "invalido");
        return;
      }
      // Sin tokens en la URL: vale si ya hay una sesión activa.
      const yo = await fetch("/api/auth/yo", { cache: "no-store" }).then((x) => x.json()).catch(() => ({ user: null }));
      if (vivo) setEstado(yo?.user ? "listo" : "invalido");
    })();
    return () => { vivo = false; };
  }, []);

  if (estado === "cargando")
    return <div className="auth-bg"><main className="auth-card"><p className="muted" role="status">Verificando el enlace…</p></main></div>;

  if (estado === "invalido")
    return (
      <div className="auth-bg">
        <main className="auth-card">
          <header><p className="auth-brand">Corte de caja</p><h1>Enlace no válido</h1></header>
          <p className="error" role="alert">El enlace ya venció o no es correcto. Pide uno nuevo.</p>
          <Link className="btn primary file-btn" href="/recuperar">Pedir otro enlace</Link>
        </main>
      </div>
    );

  return (
    <AuthForm
      title="Elige una contraseña nueva"
      subtitle="Mínimo 8 caracteres."
      submit="Guardar contraseña"
      busy="Guardando…"
      fields={[
        { name: "password", label: "Contraseña nueva", type: "password", autoComplete: "new-password" },
        { name: "confirm", label: "Repite la contraseña", type: "password", autoComplete: "new-password" },
      ]}
      onSubmit={async (v) => {
        if ((v.password ?? "").length < 8) return "La contraseña debe tener al menos 8 caracteres.";
        if (v.password !== v.confirm) return "Las contraseñas no coinciden.";
        const r = await postJson("/api/auth/contrasena", { password: v.password });
        if (!r.ok) return r.error ?? "No se pudo cambiar la contraseña.";
        await postJson("/api/auth/salir", {}); // por seguridad se cierra la sesión del enlace y se entra con la nueva
        window.location.href = ("/acceso?cambio=1");
        return null;
      }}
    />
  );
}
