# Copia a .env.local (no se versiona). Solo se usan en el servidor.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Clave pública (anon / publishable) del MISMO proyecto: la usa el servidor para iniciar sesión,
# registrar y recuperar contraseñas (Supabase Auth). Project Settings -> API.
SUPABASE_ANON_KEY=<anon-o-publishable-key>
# URL pública de la app, para los enlaces de los correos (debe estar en Auth -> URL Configuration).
APP_URL=http://localhost:3000

# URL base del servicio Python de visión (solo servidor)
VISION_API_URL=http://127.0.0.1:8000

# --- Cobros con Stripe (solo servidor; nunca NEXT_PUBLIC_) -------------------------------------
# Clave secreta del Dashboard (modo prueba: sk_test_…). Developers -> API keys.
STRIPE_SECRET_KEY=
# Secreto de firma del endpoint del webhook (whsec_…). Developers -> Webhooks -> tu endpoint.
STRIPE_WEBHOOK_SECRET=
# OBLIGATORIO: correos (separados por coma) que cobran en TU cuenta Stripe. Vacío = nadie cobra.
STRIPE_OWNER_EMAILS=
# Stripe Connect (cobros en la cuenta de cada vendedor). Deja en false hasta activar Connect en el Dashboard.
STRIPE_CONNECT_ENABLED=false
# Solo si creas un endpoint distinto para «cuentas conectadas» (Connect): su propio whsec_…
STRIPE_CONNECT_WEBHOOK_SECRET=
